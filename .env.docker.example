# Bamado Gym — Docker / production environment
# Copy to .env:  cp .env.docker.example .env
# Only foundational / secret values belong here.
# Branding, contact, hours, mail-from, currency, reminders → Admin → Gym Settings

APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
PORT=80

LOG_CHANNEL=stack
LOG_LEVEL=warning

# PostgreSQL — set ONE URL; the app parses host/port/db/user/password from it.
# Coolify: paste the Postgres internal URL (never 127.0.0.1).
# Example: postgres://USER:PASSWORD@HOST:5432/DATABASE
DB_CONNECTION=pgsql
DB_URL=postgres://bamado:change_me_strong_password@postgres:5432/bamadogym
DB_PUBLISH_PORT=5432
DB_CONNECT_TIMEOUT=3

# Prefer file sessions/cache so a bad DB_* does not take down every request.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Mail transport only — From address/name are set in Admin → Gym Settings
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# Stripe secrets — currency is set in Admin → Gym Settings
STRIPE_KEY=pk_live_replace_me
STRIPE_SECRET=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# First-boot admin (only used when seeding creates the user)
ADMIN_EMAIL=admin@bamadogym.com
ADMIN_PASSWORD=change_me_after_login

# Docker entrypoint behaviour — set RUN_SEEDERS=false after first successful deploy
RUN_MIGRATIONS=true
RUN_SEEDERS=true
CACHE_CONFIG=true
