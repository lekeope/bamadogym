# Bamado Gym — Docker / Coolify marketing MVP (no Postgres)
# cp .env.docker.example .env

APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
PORT=80

LOG_CHANNEL=stack
LOG_LEVEL=warning

# No database — file drivers only
DB_CONNECTION=sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log

CACHE_CONFIG=true

# Gym copy
GYM_NAME=Bamado Gym
GYM_TAGLINE=Train Hard. Live Strong.
GYM_HERO_SUBTITLE=Bamado Gym is Lagos's premier open-access fitness facility.
GYM_ADDRESS=123 Fitness Road, Lekki, Lagos
GYM_PHONE=+234 800 000 0000
GYM_EMAIL=info@bamadogym.com
GYM_WHATSAPP=2348000000000
GYM_HOURS_WEEKDAY=5:00 AM – 10:00 PM
GYM_HOURS_SATURDAY=6:00 AM – 8:00 PM
GYM_HOURS_SUNDAY=8:00 AM – 4:00 PM
GYM_HOURS_HOLIDAY=8:00 AM – 2:00 PM
