# Bamado Gym — marketing MVP (no database)
# Copy branding via GYM_* below or edit config/gym.php

APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Unused by the MVP landing page — keep sqlite so Laravel bootstraps cleanly.
DB_CONNECTION=sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

LOG_CHANNEL=stack
LOG_LEVEL=debug

MAIL_MAILER=log

# Gym copy (overrides config/gym.php defaults)
GYM_NAME=Bamado Gym
GYM_TAGLINE=Train Hard. Live Strong.
GYM_ADDRESS=123 Fitness Road, Lekki, Lagos
GYM_PHONE=+234 800 000 0000
GYM_EMAIL=info@bamadogym.com
# WhatsApp digits only, with country code (no +)
GYM_WHATSAPP=2348000000000
