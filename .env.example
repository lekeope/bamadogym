# Bamado Gym — local environment
# Only foundational / secret values belong here.
# Branding, contact, hours, mail-from, currency, reminders → Admin → Gym Settings

APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Local default: sqlite. For Postgres (Docker/Coolify) set:
# DB_CONNECTION=pgsql
# DB_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
DB_CONNECTION=sqlite

# Prefer file drivers until the DB is healthy (esp. Docker / Coolify).
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Mail transport only — From address/name are set in Admin → Gym Settings
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# Stripe secrets — currency is set in Admin → Gym Settings
STRIPE_KEY=pk_test_replace_me
STRIPE_SECRET=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
